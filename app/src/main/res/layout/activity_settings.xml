<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:layout_marginStart="-16dp"
                android:layout_marginEnd="-16dp"
                app:title="Settings" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:text="Unknown callers" />

            <RadioGroup
                android:id="@+id/rgUnknown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbUnkRing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Let it ring" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbUnkSilence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Silence — log it, don't ring" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbUnkReject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reject the call" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:text="Numbers the community flags as spam or fraud" />

            <RadioGroup
                android:id="@+id/rgSpam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbSpamAllow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Let it ring" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbSpamSilence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Silence — log it, don't ring" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbSpamReject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reject the call" />
            </RadioGroup>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swContacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Saved contacts always ring through" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:text="Privacy" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.8"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:text="Every decision happens on this device. No account, no upload, no analytics." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:text="About" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.8"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:text="CallSentry 0.1.0 — Know who's calling. Decide who gets through." />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/include_bottom_nav" />
</LinearLayout>
